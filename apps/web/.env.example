# Server only secrets for the /api/today proxy route (added in the core loop feature).
# Generate each secret with: openssl rand -base64 32
APP_TOKEN=
SCRIPT_URL=
SCRIPT_KEY=

# Turns on the /dev/ui component gallery: "1" on, "0" or unset off.
# Keep it unset in every deployed environment (Vercel included).
ENABLE_UI_GALLERY=
